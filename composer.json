{
    "name": "ciplnew/bugtracking",
    "type": "library",
    "description": "Report Laravel exceptions to the BugTrack Go API",
    "keywords": ["bug", "bugtrack", "bugtracking", "laravel", "error-tracking"],
    "license": "MIT",
    "authors": [
        {
            "name": "ajithkumar.a",
            "email": "ajithkumar.a@colanonline.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ciplnew\\BugTracking\\": "src"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Ciplnew\\BugTracking\\BugTrackServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
